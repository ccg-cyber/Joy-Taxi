

# ── Ci voice: ONE shared female Lebanese voice (Gemini TTS; shared module ~/CCG/shared/ci_voice) ─────────
# VOICE_PROVIDER=gemini uses it (default). VOICE_PROVIDER=elevenlabs switches back to the old ElevenLabs code.
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_VOICE_NAME=Nika
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Free-tier friendly: repeated phrases are cached on disk and cost zero requests.
# CI_VOICE_CACHE_DIR=./data/voice-cache
# CI_VOICE_RPM=3                 # max requests per minute
# CI_VOICE_DAILY_LIMIT=10        # 0 = unlimited (paid key). When spent or the API says 429: text-only for 1 hour
# FFMPEG_PATH=                   # optional; otherwise ffmpeg on PATH, then the ffmpeg-static npm binary
GEMINI_LIVE_MODEL=gemini-3.8-live   # Gemini Live (free tier), same voice/style

# Voice fallback chain (see ci/.env.example): gemini first, then ElevenLabs with a Lebanese library voice.
VOICE_CHAIN=gemini,elevenlabs
ELEVENLABS_FALLBACK_VOICE_ID=NQyF5U0t336unYhQXcuv
